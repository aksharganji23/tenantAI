# Copy this file to backend/.env for local development.
# Never commit backend/.env or a real Gmail App Password.

ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-local-secret
DATABASE_URL=sqlite:///./tenantai.db

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
SMTP_USE_TLS=true

STORAGE_DIR=./storage
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Telegram Bot Configuration
# Never commit backend/.env or this token.
TELEGRAM_BOT_TOKEN=replace-with-the-token-from-botfather
TELEGRAM_SESSION_TIMEOUT_SECONDS=120
