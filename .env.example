# ==============================================================
# TenantAI — Configuration Template (.env.example)
# ==============================================================

# Project
PROJECT_NAME="TenantAI - Secure Multi-Tenant AI Platform"
VERSION="1.0.0"
PORT=8001

# Database Configuration
# Local SQLite fallback (default out-of-the-box):
DATABASE_URL=sqlite:///./tenantai.db
# PostgreSQL with pgvector (production):
# DATABASE_URL=postgresql://tenantai_user:tenantai_secure_pass@localhost:5432/tenantai_db

# Security & JWT
SECRET_KEY=tenantai-super-secret-jwt-encryption-key-hackathon-2025
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration (Optional live Gemini API; deterministic local grounded RAG runs if omitted)
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004

# Storage & Document Limits
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_BYTES=15728640

# Frontend Next.js Public URL
NEXT_PUBLIC_API_URL=http://localhost:8001
