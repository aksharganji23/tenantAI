# ==============================================================
# TenantAI — Configuration Template (.env.example)
# ==============================================================

# Project
PROJECT_NAME="TenantAI - Secure Multi-Tenant AI Platform"
VERSION="1.0.0"
PORT=8001

# Database Configuration
# Local SQLite fallback (default out-of-the-box):
DATABASE_URL=sqlite:///./tenantai.db
# PostgreSQL with pgvector (production):
# DATABASE_URL=postgresql://tenantai_user:tenantai_secure_pass@localhost:5432/tenantai_db

# Security & JWT
SECRET_KEY=replace-with-a-long-random-production-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Email verification (leave SMTP_HOST blank for development; OTP is logged locally)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# AI Provider Configuration (Optional live Gemini API; deterministic local grounded RAG runs if omitted)
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004

# Storage & Document Limits
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_BYTES=15728640

# Frontend Next.js Public URL
NEXT_PUBLIC_API_URL=http://localhost:8001
# Telegram Bot
TELEGRAM_BOT_TOKEN=replace-with-the-token-from-botfather
TELEGRAM_SESSION_TIMEOUT_SECONDS=120
